{
  "name": "@ad-feiben/vite-plugin-modular",
  "author": "AD-feiben",
  "homepage": "https://github.com/AD-feiben/vite-plugin-modular",
  "version": "0.0.5",
  "type": "module",
  "files": [
    "dist",
    "assets"
  ],
  "main": "./dist/plugin.cjs",
  "module": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "bin": {
    "vmod": "./dist/cli.cjs",
    "vm": "./dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    },
    "./config": {
      "types": "./vmod.config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "config": [
        "./vmod.config.d.ts"
      ]
    }
  },
  "json-schema": {
    "vmod.config.json": "./schemas/vmod.config.schema.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build && tsc && chmod +x dist/cli.cjs",
    "build:types": "tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "inquirer": "^12.0.0",
    "table": "^6.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.2",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "semantic-release": "^24.2.9",
    "typescript": "~5.9.3",
    "vite": "^5.4.8",
    "vitest": "^4.0.18"
  },
  "release": {
    "branches": [
      "release"
    ],
    "plugins": [
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/git"
    ]
  }
}
