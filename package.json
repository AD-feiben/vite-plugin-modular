{
  "name": "@ad-feiben/vite-plugin-modular",
  "author": "AD-feiben",
  "homepage": "https://github.com/AD-feiben/vite-plugin-modular",
  "version": "0.0.5",
  "type": "module",
  "files": [
    "dist",
    "assets"
  ],
  "main": "./dist/plugin.cjs",
  "module": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "bin": {
    "vmod": "./dist/cli.cjs",
    "vm": "./dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    },
    "./config": {
      "types": "./vmod.config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "config": [
        "./vmod.config.d.ts"
      ]
    }
  },
  "json-schema": {
    "vmod.config.json": "./schemas/vmod.config.schema.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build && tsc && chmod +x dist/cli.cjs",
    "build:types": "tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "inquirer": "^12.0.0",
    "table": "^6.9.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.2",
    "@types/node": "^22.0.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "semantic-release": "^24.2.9",
    "typescript": "~5.9.3",
    "vite": "^5.4.8",
    "vitest": "^4.0.18"
  },
  "release": {
    "branches": ["release"],
    "plugins": [
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/git"
    ]
  }
}
